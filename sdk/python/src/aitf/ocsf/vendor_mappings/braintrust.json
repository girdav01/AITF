{
  "$schema": "https://aitf.dev/schemas/vendor-mapping-v1.json",
  "vendor": "braintrust",
  "version": "0.1",
  "description": "Maps Braintrust tracing telemetry (OTLP export) to AITF semantic conventions. Braintrust interoperates via standard gen_ai.* attributes and adds braintrust.* fields; the span type is carried in `braintrust.span_type` (llm/function/tool/task/eval/score). braintrust.* keys track Braintrust's evolving OTLP exporter and can be adjusted to match a given deployment.",
  "homepage": "https://www.braintrust.dev/docs/guides/tracing",

  "type_attribute": {
    "key": "braintrust.span_type",
    "values": {
      "llm": "inference",
      "tool": "tool",
      "function": "tool",
      "task": "agent",
      "eval": "evaluation",
      "score": "evaluation"
    }
  },

  "_note": "Detection is via the braintrust.span_type attribute (type_attribute); span-name patterns are intentionally empty to avoid stealing other vendors' name-based detection, since Braintrust span names are generic.",
  "span_name_patterns": {},

  "attribute_mappings": {
    "inference": {
      "vendor_to_aitf": {
        "braintrust.input": "gen_ai.input.messages",
        "braintrust.output": "gen_ai.output.messages",
        "braintrust.metadata.model": "gen_ai.request.model",
        "braintrust.metadata.provider": "gen_ai.provider.name",
        "braintrust.metrics.prompt_tokens": "gen_ai.usage.input_tokens",
        "braintrust.metrics.completion_tokens": "gen_ai.usage.output_tokens",
        "braintrust.metrics.tokens": "gen_ai.usage.total_tokens",

        "gen_ai.request.model": "gen_ai.request.model",
        "gen_ai.provider.name": "gen_ai.provider.name",
        "gen_ai.input.messages": "gen_ai.input.messages",
        "gen_ai.output.messages": "gen_ai.output.messages",
        "gen_ai.usage.input_tokens": "gen_ai.usage.input_tokens",
        "gen_ai.usage.output_tokens": "gen_ai.usage.output_tokens",
        "gen_ai.usage.total_tokens": "gen_ai.usage.total_tokens"
      },
      "ocsf_class_uid": 6003,
      "ocsf_activity_id_map": { "chat": 1, "text_completion": 2, "embeddings": 3, "default": 1 },
      "defaults": { "gen_ai.operation.name": "chat" }
    },

    "agent": {
      "vendor_to_aitf": {
        "braintrust.span_name": "gen_ai.agent.name",
        "braintrust.input": "agent.step.action",
        "braintrust.output": "agent.step.observation"
      },
      "ocsf_class_uid": 9001,
      "ocsf_activity_id_map": { "step_execute": 3, "default": 3 },
      "defaults": { "agent.type": "autonomous" }
    },

    "tool": {
      "vendor_to_aitf": {
        "braintrust.span_name": "gen_ai.tool.name",
        "braintrust.input": "gen_ai.tool.call.arguments",
        "braintrust.output": "gen_ai.tool.call.result"
      },
      "ocsf_class_uid": 6003,
      "ocsf_activity_id_map": { "function_call": 1, "default": 1 },
      "defaults": { "tool_type": "function" }
    },

    "evaluation": {
      "vendor_to_aitf": {
        "braintrust.score.name": "gen_ai.evaluation.name",
        "braintrust.score.value": "gen_ai.evaluation.score.value",
        "braintrust.score.reason": "gen_ai.evaluation.explanation"
      },
      "defaults": { "gen_ai.evaluation.source": "eval" }
    }
  },

  "provider_detection": {
    "attribute_keys": ["braintrust.metadata.provider", "gen_ai.provider.name"],
    "model_prefix_to_provider": {
      "gpt-": "openai", "o1": "openai", "o3": "openai",
      "claude-": "anthropic", "gemini-": "google",
      "mistral-": "mistral", "command-": "cohere", "llama-": "meta"
    }
  },

  "metadata": {
    "ocsf_product": { "name": "Braintrust", "vendor_name": "Braintrust", "version": "0.1" }
  }
}
